datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String          @id @default(uuid())
  googleId    String?         @unique
  name        String
  email       String          @unique
  avatarUrl   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  campaigns   EmailCampaign[]
  jobs        EmailJob[]

  @@map("users")
}

model EmailCampaign {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject            String
  body               String
  textBody           String?
  cc                 String?
  bcc                String?
  startTime          DateTime
  delayBetweenEmails Int          @default(2000) // milliseconds
  hourlyLimit        Int          @default(200)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  jobs               EmailJob[]
  attachments        Attachment[]

  @@index([userId])
  @@index([createdAt])
  @@map("email_campaigns")
}

model EmailJob {
  id            String        @id @default(uuid())
  campaignId    String
  campaign      EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient     String
  cc            String?
  bcc           String?
  subject       String
  body          String
  textBody      String?
  scheduledAt   DateTime
  sentAt        DateTime?
  status        String        @default("SCHEDULED")
  attempts      Int           @default(0)
  errorMessage  String?
  smtpMessageId String?
  bullJobId     String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@index([campaignId])
  @@index([recipient])
  @@map("email_jobs")
}

model Attachment {
  id          String        @id @default(uuid())
  campaignId  String
  campaign    EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  filename    String
  filepath    String
  mimetype    String
  size        Int
  createdAt   DateTime      @default(now())

  @@index([campaignId])
  @@map("attachments")
}
